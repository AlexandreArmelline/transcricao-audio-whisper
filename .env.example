# =============================================================================
# Exemplo de variáveis de ambiente (copie para .env e ajuste)
# =============================================================================

# Modelo Whisper: auto | tiny | base | small | medium | large-v3
WHISPER_MODEL=auto

# Tipo de precisão: int8_float32 (leve) | float32 (máxima)
WHISPER_COMPUTE_TYPE=int8_float32

# Pastas (opcional — use apenas se quiser caminhos customizados/persistentes)
# PASTA_UPLOADS=/data/uploads
# PASTA_TRANSCRICOES=/data/transcricoes
# PASTA_MODELOS=/data/models

# Porta do servidor
PORT=5000

# 1 apenas em desenvolvimento local
FLASK_DEBUG=0
